<!DOCTYPE html>
<html>

<head>

  <meta charset="UTF-8">

  <title>Dashboard</title>

  <link rel="stylesheet" href="style.css">

  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script src="supabase.js"></script>

</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">

  <button class="nav-btn" onclick="go('home.html')">
    <i class="fa-solid fa-house"></i>
    Home
  </button>

  <button class="nav-btn" onclick="go('index.html')">
    <i class="fa-solid fa-chart-line"></i>
    Dashboard
  </button>

  <button class="nav-btn" onclick="go('notes.html')">
    <i class="fa-solid fa-note-sticky"></i>
    Notes
  </button>

</div>

<!-- MAIN -->
<div class="main">

  <h1>📚 DevOps Roadmap</h1>

  <div
    id="subjectsContainer"
    class="subjects-grid">

  </div>

</div>

<script>

/* =========================================
   NAVIGATION
========================================= */

function go(page){
  window.location.href = page
}

/* =========================================
   GET USER
========================================= */

async function getUser(){

  const { data } =
    await supabaseClient.auth.getUser()

  return data?.user
}

/* =========================================
   TOGGLE WEEK
========================================= */

function toggleWeek(id){

  const element =
    document.getElementById(id)

  element.classList.toggle("show-week")
}

/* =========================================
   TOGGLE TOPIC
========================================= */

function toggleTopic(id){

  const element =
    document.getElementById(id)

  element.classList.toggle("show-topic")
}

/* =========================================
   TOGGLE SUBTOPIC
========================================= */

async function toggleSubtopic(subtopicId){

  const user = await getUser()

  const { data: existing } =
    await supabaseClient
      .from("subtopic_progress")
      .select("*")
      .eq("user_id", user.id)
      .eq("subtopic_id", subtopicId)
      .maybeSingle()

  if(existing){

    await supabaseClient
      .from("subtopic_progress")
      .delete()
      .eq("id", existing.id)

  } else {

    await supabaseClient
      .from("subtopic_progress")
      .insert([{
        user_id:user.id,
        subtopic_id:subtopicId,
        completed:true
      }])
  }

  loadSubjects()
}

/* =========================================
   LOAD SUBJECTS
========================================= */

async function loadSubjects(){

  const user = await getUser()

  const { data: subjects } =
    await supabaseClient
      .from("subjects")
      .select("*")
      .order("created_at", {
        ascending:true
      })

  const container =
    document.getElementById("subjectsContainer")

  let html = ""

  for(const subject of subjects){

    /* WEEKS */
    const { data: weeks } =
      await supabaseClient
        .from("weeks")
        .select("*")
        .eq("subject_id", subject.id)
        .order("week_number", {
          ascending:true
        })

    /* SUBJECT SUBTOPICS */
    const { data: topicData } =
      await supabaseClient
        .from("topics")
        .select(`
          *,
          subtopics(*)
        `)
        .eq("subject_id", subject.id)

    const allSubtopics =
      topicData.flatMap(
        t => t.subtopics || []
      )

    /* USER PROGRESS */
    const { data: progress } =
      await supabaseClient
        .from("subtopic_progress")
        .select("*")
        .eq("user_id", user.id)

    const completedIds =
      progress.map(
        p => p.subtopic_id
      )

    const totalSubtopics =
      allSubtopics.length

    const completedSubtopics =
      allSubtopics.filter(
        s => completedIds.includes(s.id)
      ).length

    const percent =
      totalSubtopics > 0
      ? Math.round(
          (completedSubtopics / totalSubtopics) * 100
        )
      : 0

    html += `

      <div class="card subject-card">

        <h2>
          📘 ${subject.name}
        </h2>

        <p>
          Progress: ${percent}%
        </p>

    `

    /* WEEKS */
    for(const week of weeks){

      const { data: topics } =
        await supabaseClient
          .from("topics")
          .select("*")
          .eq("week_id", week.id)

      html += `

        <div class="week-card">

          <div
            class="week-header"
            onclick="toggleWeek('week-${week.id}')">

            <span>
              ▶ Week ${week.week_number}
            </span>

            <span>
              ${week.title}
            </span>

          </div>

          <div
            id="week-${week.id}"
            class="week-content">

      `

      /* TOPICS */
      for(const topic of topics){

        const { data: subtopics } =
          await supabaseClient
            .from("subtopics")
            .select("*")
            .eq("topic_id", topic.id)

        html += `

          <div class="topic-card">

            <div
              class="topic-header"
              onclick="toggleTopic('topic-${topic.id}')">

              ▶ ${topic.title}

            </div>

            <div
              id="topic-${topic.id}"
              class="topic-content">

        `

        /* SUBTOPICS */
        for(const sub of subtopics){

          const checked =
            completedIds.includes(sub.id)

          html += `

            <div class="subtopic-item">

              <label>

                <input
                  type="checkbox"

                  ${
                    checked
                    ? "checked"
                    : ""
                  }

                  onchange="
                    toggleSubtopic(
                      '${sub.id}'
                    )
                  "
                >

                ${sub.title}

              </label>

            </div>
          `
        }

        html += `
            </div>
          </div>
        `
      }

      html += `
          </div>
        </div>
      `
    }

    html += `
      </div>
    `
  }

  container.innerHTML = html
}

loadSubjects()

</script>

</body>
</html>
