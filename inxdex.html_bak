<!DOCTYPE html>
<html>
<head>

  <title>Study Workspace</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="supabase.js"></script>

  <style>

    body{
      margin:0;
      font-family:Arial;
      background:#0f172a;
      color:white;
      display:flex;
      height:100vh;
    }

    /* SIDEBAR */
    .sidebar{
      width:230px;
      background:#1e293b;
      padding:20px;
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .title{
      font-size:18px;
      font-weight:bold;
      margin-bottom:10px;
    }

    .nav-btn{
      background:#334155;
      color:white;
      border:none;
      padding:10px;
      border-radius:10px;
      cursor:pointer;
      text-align:left;
      transition:0.2s;
    }

    .nav-btn:hover{
      background:#475569;
    }

    .active{
      background:#38bdf8 !important;
      color:black;
      font-weight:bold;
    }

    /* MAIN */
    .main{
      flex:1;
      padding:25px;
      overflow:auto;
    }

    .card{
      background:#1e293b;
      padding:20px;
      border-radius:15px;
      margin-bottom:15px;
    }

    .progress-bar{
      width:100%;
      background:#334155;
      height:10px;
      border-radius:10px;
      overflow:hidden;
      margin:6px 0 14px;
    }

    .progress-fill{
      height:100%;
      background:#38bdf8;
    }

  </style>

</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">

  <div class="title">📘 Study Workspace</div>

  <button id="dashBtn" class="nav-btn active" onclick="showDashboard()">
    Dashboard
  </button>

  <button id="notesBtn" class="nav-btn" onclick="goNotes()">
    Notes
  </button>

  <button class="nav-btn" onclick="logout()">
    Logout
  </button>

</div>

<!-- MAIN -->
<div class="main">

  <h1 id="pageTitle">Dashboard</h1>

  <div id="content">Loading...</div>

</div>

<script>

let currentPage = "dashboard"

// -------------------
// LOAD DASHBOARD
// -------------------
async function loadDashboard(){

  const { data: profiles } =
    await supabaseClient.from("profiles").select("*")

  const { data: progress } =
    await supabaseClient.from("progress").select("*")

  let html = ""

  profiles.forEach(p => {

    const prog = progress.find(x => x.user_id === p.id)

    html += `
      <div class="card">

        <h3>${p.name}</h3>

        <div>
          <small>Linux</small>
          <div class="progress-bar">
            <div class="progress-fill" style="width:${prog?.linux || 0}%"></div>
          </div>
        </div>

        <div>
          <small>Docker</small>
          <div class="progress-bar">
            <div class="progress-fill" style="width:${prog?.docker || 0}%"></div>
          </div>
        </div>

        <div>
          <small>Kubernetes</small>
          <div class="progress-bar">
            <div class="progress-fill" style="width:${prog?.kubernetes || 0}%"></div>
          </div>
        </div>

      </div>
    `
  })

  document.getElementById("content").innerHTML = html
}

// -------------------
// NAVIGATION (NO RELOAD STYLE)
// -------------------
function setActive(btn){

  document.getElementById("dashBtn").classList.remove("active")
  document.getElementById("notesBtn").classList.remove("active")

  if(btn === "dashboard"){
    document.getElementById("dashBtn").classList.add("active")
  }

  if(btn === "notes"){
    document.getElementById("notesBtn").classList.add("active")
  }

}

// -------------------
// PAGE SWITCH
// -------------------
function showDashboard(){

  currentPage = "dashboard"

  setActive("dashboard")

  document.getElementById("pageTitle").innerText = "Dashboard"

  loadDashboard()
}

function goNotes(){

  window.location.href = "notes.html"

}

// -------------------
// LOGOUT
// -------------------
async function logout(){
  await supabaseClient.auth.signOut()
  window.location.href = "login.html"
}

// INIT
loadDashboard()

</script>

</body>
</html>
