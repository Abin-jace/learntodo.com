<!DOCTYPE html>
<html>

<head>

  <meta charset="UTF-8">

  <title>Study Workspace</title>

  <link rel="stylesheet" href="style.css">

  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script src="supabase.js"></script>

</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">

  <button class="nav-btn active-nav" onclick="go('home.html')">
    <i class="fa-solid fa-house"></i>
    Home
  </button>

  <button class="nav-btn" onclick="go('index.html')">
    <i class="fa-solid fa-chart-line"></i>
    Dashboard
  </button>

  <button class="nav-btn" onclick="go('notes.html')">
    <i class="fa-solid fa-note-sticky"></i>
    Notes
  </button>

</div>

<!-- MAIN -->
<div class="main">

  <!-- TOP -->
  <div class="home-top">

    <div class="glass-card welcome-card">

      <h1 id="welcomeText">
        Hey 👋
      </h1>

      <p>
        Focus on your learning today 🚀
      </p>

    </div>

    <button
      class="logout-btn"
      onclick="logout()">

      Logout

    </button>

  </div>

  <!-- GRID -->
  <div class="home-grid">

    <!-- CLOCK -->
    <div class="glass-card flip-clock-card">

      <div id="clock">

        00:00:00

      </div>

    </div>

    <!-- NOTES -->
    <div class="glass-card note-card">

      <h2>📝 Quick Notes</h2>

      <textarea
        placeholder="Write something..."></textarea>

    </div>

    <!-- TEAM PROGRESS -->
    <div class="glass-card squad-card">

      <h2>
        👥 Squad Progress
      </h2>

      <div id="squadContainer">

        Loading...

      </div>

    </div>

    <!-- CONTINUE -->
    <div class="glass-card continue-card">

      <h2>
        📚 Continue Learning
      </h2>

      <p>
        Continue your DevOps roadmap journey.
      </p>

      <button
        class="open-dashboard-btn"
        onclick="go('index.html')">

        Open Dashboard

      </button>

    </div>

  </div>

</div>

<script>

/* =========================================
   NAVIGATION
========================================= */

function go(page){

  window.location.href = page
}

/* =========================================
   LOGOUT
========================================= */

async function logout(){

  await supabaseClient.auth.signOut()

  window.location.href = "login.html"
}

/* =========================================
   CLOCK
========================================= */

function updateClock(){

  const now = new Date()

  const time =
    now.toLocaleTimeString()

  document.getElementById("clock")
    .innerText = time
}

setInterval(updateClock,1000)

updateClock()

/* =========================================
   LOAD USER
========================================= */

async function loadUser(){

  const { data } =
    await supabaseClient.auth.getUser()

  const user = data?.user

  if(!user) return

  const { data: profile } =
    await supabaseClient
      .from("profiles")
      .select("*")
      .eq("id", user.id)
      .single()

  if(profile){

    document.getElementById("welcomeText")
      .innerText = `Hey, ${profile.name} 👋`
  }
}

/* =========================================
   LOAD TEAM PROGRESS
========================================= */

async function loadSquadProgress(){

  const squadContainer =
    document.getElementById("squadContainer")

  try {

    const [

      profilesRes,
      subtopicsRes,
      progressRes

    ] = await Promise.all([

      supabaseClient
        .from("profiles")
        .select("*"),

      supabaseClient
        .from("subtopics")
        .select("*"),

      supabaseClient
        .from("subtopic_progress")
        .select("*")

    ])

    const profiles =
      profilesRes.data || []

    const subtopics =
      subtopicsRes.data || []

    const progress =
      progressRes.data || []

    const totalSubtopics =
      subtopics.length

    let html = ""

    for(const profile of profiles){

      const userProgress =
        progress.filter(
          p => p.user_id === profile.id
        )

      const completed =
        userProgress.length

      const percent =
        totalSubtopics > 0
        ? Math.round(
            (completed / totalSubtopics) * 100
          )
        : 0

      html += `

        <div class="gauge-card">

          <div
            class="gauge"

            style="
              background:
              conic-gradient(
                #8b5cf6 ${percent * 3.6}deg,
                rgba(255,255,255,0.08) 0deg
              );
            ">

            <div class="gauge-inner">

              <span>
                ${percent}%
              </span>

            </div>

          </div>

          <p class="gauge-name">

            ${profile.name}

          </p>

        </div>

      `
    }

    squadContainer.innerHTML = html

  } catch(err){

    console.error(err)

    squadContainer.innerHTML =
      "Error loading squad progress"
  }
}

loadUser()

loadSquadProgress()

/* =========================================
   LOAD USER NAME FROM AUTH
========================================= */

async function loadProfile(){

  try {

    const {

      data:{ user }

    } = await supabaseClient.auth.getUser()

    if(!user){

      window.location.replace("login.html")

      return
    }

    console.log("AUTH USER:", user)

    /* NAME OPTIONS */
    const name =
      user.user_metadata?.name ||
      user.email?.split("@")[0] ||
      "User"

    document.getElementById(
      "userName"
    ).innerText = " " + name

  } catch(err){

    console.error(err)
  }
}

loadProfile()

</script>

</body>
</html>
